// Signing and bundle id. Put your own values in Config/Local.xcconfig (not committed):
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = com.yourname.yebeyt
PRODUCT_BUNDLE_IDENTIFIER = com.yebeyt.app
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Backend (see server/). "/$()/" keeps xcconfig from reading "//" as a comment.
BEYT_API_URL = https:/$()/api.yebeyt.com

// Google Sign-In: the iOS OAuth client id and its reversed form (URL scheme). Empty = Google button hidden.
GOOGLE_CLIENT_ID = 587119002915-eosraa9cam7d314kt6s86t0bnbd6e4fa.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.587119002915-eosraa9cam7d314kt6s86t0bnbd6e4fa

#include? "Local.xcconfig"
