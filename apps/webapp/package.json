{
  "name": "@yebeyt/webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node ../../packages/tokens/copy-fonts.mjs public/fonts --reader && node scripts/copy-data.mjs",
    "dev": "next dev",
    "prebuild": "node ../../packages/tokens/copy-fonts.mjs public/fonts --reader && node scripts/copy-data.mjs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "api:types": "node scripts/api-types.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "@yebeyt/avatar": "workspace:*",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1"
  }
}
