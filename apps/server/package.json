{
  "name": "@yebeyt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "api:generate": "tsx scripts/openapi.ts",
    "api:check": "tsx scripts/openapi.ts --check",
    "pictures:upload": "tsx scripts/upload-pictures.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/node-ws": "^1.3.2",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
