{"id":293,"poems":[[66224,293,"sh1","الهی کمال الهی توراست",38,"",1],[66225,293,"sh2","کرم گسترا عاجز و مضطرم",32,"",0],[66226,293,"sh3","سر سروران تاج آزادگان",21,"",0],[66227,293,"sh4","شبی کز شرف غیرت روز بود",47,"",0],[66228,293,"sh5","به فیض ازل هر که را همرهیست",35,"",0],[66229,293,"sh6","دلم را چو فکرت بدینجا رسید",26,"",0],[66230,293,"sh7","شنیدم که این نکته را ساده ای",19,"",0],[66231,293,"sh8","بیا ای جگر گوشه فرزند من",39,"",0],[66232,293,"sh9","دلا دیده دوربین برگشای",35,"",0],[66233,293,"sh10","یکی کعبه رو گم شد از قافله",27,"",0],[66234,293,"sh11","سخن ز آسمان ها فرود آمده ست",63,"",0],[66235,293,"sh12","یکی خاد مرغ هوایی شکار",27,"",0],[66236,293,"sh13","شناسای تاریخ های کهن",46,"",0],[66237,293,"sh14","حکیمی نه بر صورت دلپسند",21,"",0],[66238,293,"sh15","سکندر چو ز آلایش جهل پاک",53,"",0],[66239,293,"sh16","جهاندیده پیری به سودای گشت",33,"",0],[66240,293,"sh17","چنین گفت دانشور روم و روس",37,"",0],[66241,293,"sh18","گفت اگر اینست رسم مهتری",20,"",0],[66242,293,"sh19","دَبیرِ خِرَدمندِ دانِش پَژوه",50,"",0],[66243,293,"sh20","کمان گردنی از پی و استخوان",38,"",0],[66244,293,"sh21","فلاطون که فر الهیش بود",66,"",0],[66245,293,"sh22","شنیدم که شاهی به هندوستان",24,"",0],[66246,293,"sh23","زهی گنج حکمت که سقراط بود",89,"",0],[66247,293,"sh24","به عمان یکی مرغ فرتوت بود",35,"",0],[66248,293,"sh25","ز هر تار حکمت که او تافته ست",92,"",0],[66249,293,"sh26","به یونان حکیمی فلاطون محل",21,"",0],[66250,293,"sh27","چنین است در سفرهای قدیم",49,"",0],[66251,293,"sh28","به بغداد شد گامزن زیرکی",11,"",0],[66252,293,"sh29","خرد جمله لب شد زمین بوس را",24,"",0],[66253,293,"sh30","یکی تازه برنای نوخاسته",14,"",0],[66254,293,"sh31","ز هرمس که هر مس زر ناب کرد",48,"",0],[66255,293,"sh32","یکی سفله با شکلی از طبع دور",18,"",0],[66256,293,"sh33","گهرسنج این گنج گوهرفشان",45,"",0],[66257,293,"sh34","غریبی ز فضل و هنر بهره ور",19,"",0],[66258,293,"sh35","سکندر که گنجینه راز بود",50,"",0],[66259,293,"sh36","خلیفه که سلطان آفاق بود",11,"",0],[66260,293,"sh37","بیا ای چو عیسی تجرد نهاد",33,"",0],[66261,293,"sh38","یکی روز پرویز و شیرین به هم",36,"",0],[66262,293,"sh39","سکندر ز اقصای یونان زمین",36,"",0],[66263,293,"sh40","شنیدم که در عهد نوشیروان",22,"",0],[66264,293,"sh41","سکندر که صیتش جهان را گرفت",22,"",0],[66265,293,"sh42","جوانی به بر جامه خسروی",18,"",0],[66266,293,"sh43","سکندر به سوی ارسطو نوشت",27,"",0],[66267,293,"sh44","ز شاهان پیشین ستم پیشه ای",15,"",0],[66268,293,"sh45","ارسطو که در حکمت استاد بود",41,"",0],[66269,293,"sh46","سکندر چو بر هند لشکر کشید",51,"",0],[66270,293,"sh47","حکیمی از آنجا که روشندلان",24,"",0],[66271,293,"sh48","سکندر چو می گشت گرد جهان",59,"",0],[66272,293,"sh49","حکیمی ز مردم کناری گرفت",25,"",0],[66273,293,"sh50","مغنی چو بندد در آهنگ فقر",49,"",0],[66274,293,"sh51","سکندر شهنشاه اقلیم راز",46,"",0],[66275,293,"sh52","یکی مرزبان بود در مرز مرو",41,"",0],[66276,293,"sh53","چنین داد داننده داد سخن",93,"",0],[66277,293,"sh54","خوش آن کس که کارش نکویی بود",23,"",0],[66278,293,"sh55","شنیدم که فرزانه مردی حکیم",12,"",0],[66279,293,"sh56","سکندر چو زد از وصیت نفس",22,"",0],[66280,293,"sh57","یکی گفت وقت است ای هوشیار",10,"",0],[66281,293,"sh58","بگفت آن دگر کز جهان فراخ",10,"",0],[66282,293,"sh59","حکیمی دگر گفت کان کامگار",6,"",0],[66283,293,"sh60","حکیم چهارم ز کارآگهان",4,"",0],[66284,293,"sh61","به دانای پنجم چو نوبت فتاد",5,"",0],[66285,293,"sh62","حکیم ششم چون سخن ساز کرد",3,"",0],[66286,293,"sh63","به هفتم چو آمد سخن لب گشود",2,"",0],[66287,293,"sh64","ز هشتم جز این نکته سر بر نزد",4,"",0],[66288,293,"sh65","نهم گفت هر کس که از مرگ شاه",3,"",0],[66289,293,"sh66","دهم گفت هر مخزن سیم و زر",2,"",0],[66290,293,"sh67","چو آمد به سر نوبت قال و قیل",27,"",0],[66291,293,"sh68","حکیم نخستین چو شد پرده ساز",11,"",0],[66292,293,"sh69","چو خامش شد آن پیر یزدان شناس",11,"",0],[66293,293,"sh70","حکیم دوم چون لب از نطق بست",11,"",0],[66294,293,"sh71","ازین گفت و گو چون سیم لب بدوخت",11,"",0],[66295,293,"sh72","حکیم چهارم چو گفت آنچه گفت",11,"",0],[66296,293,"sh73","چو آن در پس ستر عصمت مقیم",11,"",0],[66297,293,"sh74","پی راحت جان آگاه خویش",30,"",0],[66298,293,"sh75","چو سرچشمه فیض اسکندری",32,"",0],[66299,293,"sh76","رباطیست گیتی دو در ساخته",46,"",0],[66300,293,"sh77","سراسیمه ای خانه در بلخ داشت",17,"",0],[66301,293,"sh78","بیا جامی ای عمرها برده رنج",31,"",0]]}
