{"id":206,"poems":[[13739,206,"sh1","خامه برآورد صدای صریر",5,"",0],[13740,206,"sh2","طرح نوی در سخن انداختم",51,"",1],[13741,206,"sh3","فرض بود بر همه شکر و سپاس",51,"",0],[13742,206,"sh4","اهل دلی ترک جهان کرده بود",79,"",0],[13743,206,"sh5","پادشهی بود ملایک‌سپاه",105,"",0],[13744,206,"sh6","نادره گویی ز سخن گستران",73,"",0],[13745,206,"sh7","جاهلی از گنج خرد تنگدست",87,"",0],[13746,206,"sh8","بود سفیهی به سفاهت علم",58,"",0],[13747,206,"sh9","بی درمی خار کشیدی به پشت",77,"",0]]}
