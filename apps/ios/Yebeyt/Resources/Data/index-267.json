{"id":267,"poems":[[19726,268,"sh1","هر که جان دارد و روان دارد",16,"",0],[19727,268,"sh2","مبدا امر جوهر انسان",29,"",0],[19728,268,"sh3","سر او در سر یقین و گمان",31,"",0],[19729,268,"sh4","نقل کن از وبال کفر بدین",11,"",0],[19730,268,"sh5","چار یارش، که مرشد دینند",8,"",0],[19731,268,"sh6","تا کی، ای مست خواب غفلت و جهل",26,"",0],[19732,268,"sh7","جان من چون به عالم دل شد",19,"",0],[19733,268,"sh8","حق تعالی میان هر عصری",32,"",0],[19734,268,"sh9","گفت استاد عالم عاقل:",14,"",0],[19735,268,"sh10","چون سکندر ز منزل عادات",19,"",0],[19736,268,"sh11","صاحبا، راز اندرون ز نهفت",9,"",0],[19737,269,"sh1","حبذا عشق و حبذا عشاق",8,"اعشاق",0],[19738,269,"sh2","عاشقان ره به عشق می‌پویند",12,"",0],[19739,269,"sh3","بی جمال تو، ای جهان افروز",7,"وز",0],[19740,269,"sh4","دل ما، چون چراغ عشق افروخت",16,"",0],[19741,269,"sh5","دل من، چون به عشق مایل شد",6,"لشد",0],[19742,269,"sh6","آفت عاشقی نه از سر ماست",10,"",0],[19743,270,"sh1","بود در کنج خانه صبح دمی",29,"",0],[19744,270,"sh2","ای ملامت کنان بی‌حاصل",9,"ل",0],[19745,270,"sh3","چون بدید این غزل بدین سان خوب",9,"",0],[19746,270,"sh4","ای ز روی تو آفتاب خجل",9,"ل",0],[19747,270,"sh5","آن غزال این غزل چو زیبا دید",36,"",0],[19748,271,"sh1","آن غریبان منزل دنیی",20,"",0],[19749,271,"sh2","جنت قرب جای ایشان است",10,"ایایشاناست",0],[19750,271,"sh3","آنکه ایشان برو نظر کردند",13,"",0],[19751,271,"sh4","بود معروف زاده‌ای عاقل",27,"",0],[19752,271,"sh5","«انما العاشقون مذبوحون»",11,"",0],[19753,271,"sh6","هر دلی کان به عشق مایل نیست",5,"لنیست",0],[19754,271,"sh7","هر که بر خوان این هوس خام است",5,"",0],[19755,271,"sh8","آن شنیدی که عاشقی جانباز",44,"",0],[19756,272,"sh1","مطربا، نغمهٔ حزین بر دار",19,"",0],[19757,272,"sh2","بود مردی همیشه در گلخن",68,"",0],[19758,272,"sh3","در هوای تو جان و تن بارست",7,"ست",0],[19759,272,"sh4","آن پری، بعد از آنکه تیر انداخت",12,"",0],[19760,272,"sh5","تیری، ای دوست، برکش از ترکش",7,"ش",0],[19761,272,"sh6","هر که را نیست عیش خوش بی‌دوست",10,"",0],[19762,273,"sh1","ساقیا، بادهٔ صبوح بده",13,"",0],[19763,273,"sh2","دل و جانی است با من مشتاق",7,"اق",0],[19764,273,"sh3","نکند جز که شوق دیدارت",12,"",0],[19765,273,"sh4","پسری داشت شحنهٔ تبریز",27,"",0],[19766,274,"sh1","ما مقیم آستان توایم",12,"",0],[19767,274,"sh2","گر ز شمعت چراغی افروزیم",7,"وزیم",0],[19768,274,"sh3","تا غمت با من آشنایی کرد",9,"",0],[19769,274,"sh4","یکی از عاشقان جمالت را",39,"",0],[19770,275,"sh1","ای هوای تو مونس جانم",15,"",0],[19771,275,"sh2","ای شده چشم جان من به تو باز",9,"از",0],[19772,275,"sh3","ای غم تو مجاور دل من",6,"",0],[19773,275,"sh4","بود صاحبدلی به دانش و هوش",23,"",0],[19774,275,"sh5","عاشقی ترک خواب و خور کرده",7,"رکرده",0],[19775,275,"sh6","عاشق بی‌قرار، از سر درد",44,"",0],[19776,276,"sh1","مرحبا! مرحبا! محبت دوست",12,"",1],[19777,276,"sh2","آشکارا نهان کنم تا چند؟",10,"ند",1],[19778,276,"sh3","دیده‌ای پاک بین همی باید",11,"",1],[19779,276,"sh4","پیر شیراز، شیخ روزبهان",21,"",0],[19780,276,"sh5","نیست کاری به آنم و اینم",7,"ینم",0],[19781,276,"sh6","ای خوش و فارغ، از غم ما پرس",7,"",0],[19782,277,"sh1","عاشقان در کمین معشوقند",7,"",0],[19783,277,"sh2","ای ربوده دلم به رعنایی",9,"ایی",0],[19784,277,"sh3","عکس هر مویت، ای بت رعنا",11,"",0],[19785,277,"sh4","شیخ السلام امام غزالی",25,"",0],[19786,277,"sh5","دل دیوانه باز بر در عشق",7,"رعشق",0],[19787,277,"sh6","اگر، ای آرزوی جان که تویی",17,"",0],[19788,277,"sh7","سهل گفتی به ترک جان گفتن",7,"انگفتن",0],[19789,277,"sh8","جز حدیث تو من نمی‌دانم",8,"",0],[19790,277,"sh9","چون درآمد به شهر دوست فقیر",19,"",0],[19791,278,"sh1","مرحبا! مرحبا! نسیم صبا",18,"",0],[19792,278,"sh2","دل چو در دام عشق منظور است",7,"وراست",0],[19793,278,"sh3","از تو مهرم چو در نهاد بود",8,"",0]]}
