{"id":1138,"poems":[[39175,1138,"sh1","به نام خدایی که با تیره خاک",25,"",0],[39176,1138,"sh2","الهی، الهی، خطا کرده‌ایم",20,"",0],[39177,1138,"sh3","رسولی که پا بر سر عرش سود",60,"",0],[39178,1138,"sh4","الا ای جگر گوشه فرزند من،",93,"",0],[39179,1138,"sh5","شنیدم که شاهی به ایران زمین",34,"",0],[39180,1138,"sh6","بهاران که خندان شدی نسترن",23,"",0],[39181,1138,"sh7","چو بنمودی از برج مه مهر چهر",25,"",0],[39182,1138,"sh8","به وقتی که باد خزان خاستی",21,"",0],[39183,1138,"sh9","کجا تاختی خسرو خاروان",22,"",0],[39184,1138,"sh10","شبی همچو روز قیامت دراز",92,"",0],[39185,1138,"sh11","‌سر نامه بنوشت نام خدای",153,"",0],[39186,1138,"sh12","که آب روان بخش در جویبار",206,"",0],[39187,1138,"sh13","همین قصه می‌کرد مرغی به باغ",135,"",0],[39188,1138,"sh14","از آن پس چو آمد به شاه آگهی",178,"",0],[39189,1138,"sh15","الا ایکه داری امید وصال",69,"",0]]}
