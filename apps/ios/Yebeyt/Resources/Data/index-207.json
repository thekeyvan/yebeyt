{"id":207,"poems":[[13748,207,"sh1","زهی نام تو سر دیوان هستی",49,"",0],[13749,207,"sh2","ایا مدهوش جام خواب غفلت",19,"",0],[13750,207,"sh3","خداوندا گنهکاریم جمله",28,"",0],[13751,207,"sh4","رقم سازی که این زیبا رقم زد",29,"",0],[13752,207,"sh5","شبی چون روز شادی عشرت افزای",47,"",0],[13753,207,"sh6","از آنرو صبح این روشندلی یافت",46,"",0],[13754,207,"sh7","شبی سامان ده سد ماتم وغم",42,"",0],[13755,207,"sh8","چو این گنج هنر ترتیب دادم",41,"",0],[13756,207,"sh9","دلا برخیز تا کنجی نشینیم",42,"",0],[13757,207,"sh10","نوا پرداز قانون فصاحت",68,"",0],[13758,207,"sh11","دبیر مکتب نادر بیانی",37,"",0],[13759,207,"sh12","چنین گفت آن ادیب نکته پرداز",73,"",0],[13760,207,"sh13","چو آن زرین قلم از خانهٔ زر",30,"",0],[13761,207,"sh14","چو طفل روز رفت از مکتب خاک",45,"",0],[13762,207,"sh15","اسیر درد شبهای جدایی",41,"",0],[13763,207,"sh16","سفر سازندهٔ این طرفه صحرا",44,"",0],[13764,207,"sh17","حدا گویندهٔ این طرفه محمل",104,"",0],[13765,207,"sh18","گهر پاشی که این گوهر گزین کرد",33,"",0],[13766,207,"sh19","فسون سازی که این افسون نماید",36,"",0],[13767,207,"sh20","سوار رخش تاز دشت دعوی",43,"",0],[13768,207,"sh21","سمند ره نورد این بیانان",73,"",0],[13769,207,"sh22","صف آرایندهٔ این طرفه لشکر",116,"",0],[13770,207,"sh23","سلاسل ساز این فرخنده تحریر",32,"",0],[13771,207,"sh24","نوا آموز این دلکش ترانه",40,"",0],[13772,207,"sh25","ز ره پیمای این صحرای دلگیر",33,"",0],[13773,207,"sh26","به جست و جوی آن مجنون گمنام",37,"",0],[13774,207,"sh27","برد ره نکته ساز معنی اندیش",100,"",0],[13775,207,"sh28","دلا بر عکس ابنای زمان باش",43,"",0],[13776,207,"sh29","عروس نظم را جویای این بکر",91,"",0],[13777,207,"sh30","چنین از یاری کلک جوانبخت",61,"",0],[13778,207,"sh31","بحمدالله که گر دیدیم رنجی",38,"",0]]}
