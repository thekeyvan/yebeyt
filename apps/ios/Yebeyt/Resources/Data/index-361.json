{"id":361,"poems":[[24252,361,"sh1","ای داده به دل خزینهٔ راز",15,"",0],[24253,361,"sh2","ای عذر پذیر عذرخواهان",26,"",0],[24254,361,"sh3","شاه رسل و شفیع مرسل",4,"",0],[24255,361,"sh4","فرخنده شبی که آن جهان گیر",24,"",0],[24256,361,"sh5","چون گوهر مدح خواجه سفتم",9,"",0],[24257,361,"sh6","شاهی که، به نصرت خدایی،",7,"",0],[24258,361,"sh7","چون من بدو نامه زین ورق پیش",23,"",0],[24259,361,"sh8","ای چاره ده‌ ماهه زرگانی",80,"",0],[24260,361,"sh9","گویند که در عرب، جوانی",19,"",0],[24261,361,"sh10","دندانه گشای قفل این راز",72,"",0],[24262,361,"sh11","چون رفت به گوش هر کس این راز",47,"",0],[24263,361,"sh12","چون ماند پری‌وش حصاری",104,"",0],[24264,361,"sh13","گوینده، حکایت آن چنان کرد",29,"",0],[24265,361,"sh14","پیر از دل دردمند برخاست",41,"",0],[24266,361,"sh15","خوانندهٔ حرف آشنایی",55,"",0],[24267,361,"sh16","توقیع کش مثال این حرف",81,"",0],[24268,361,"sh17","گویندهٔ این کهن فسانه",15,"",0],[24269,361,"sh18","آغاز صحیفهٔ معانی",53,"",0],[24270,361,"sh19","آغاز سخن به نام شاهی",51,"",0],[24271,361,"sh20","چون نافه گشاد باد نوروز",63,"",0],[24272,361,"sh21","یک روز، به گاه نیم روزان،",64,"",0],[24273,361,"sh22","افسانه سرای شکرین گفت",91,"",0],[24274,361,"sh23","چون بر سر چرخ لاجوردی",15,"",0],[24275,361,"sh24","بازم غم عشق در سر افتاد",39,"",0],[24276,361,"sh25","گوینده چنین فگند بنیاد",13,"",0],[24277,361,"sh26","ما هیچ کسان کوی یاریم",30,"",0],[24278,361,"sh27","گویندهٔ این حدیث زیبا",72,"",0],[24279,361,"sh28","آمد چو خزان به غارت باغ",74,"",0],[24280,361,"sh29","خوانندهٔ این خط کهن‌سال",58,"",0],[24281,361,"sh30","ماتم کده شد جهان نهان نیست",25,"",0],[24282,361,"sh31","چون گنج هنر گشاد بختم",54,"",0]]}
