{"id":287,"poems":[[65486,1889,"sh1","لله الحمد قبل کل کلام",34,"",0],[65487,1889,"sh2","جل من لااله الا هو",24,"",0],[65488,1889,"sh3","دوربینان بارگاه الست",18,"",0],[65489,1889,"sh4","وصف حق حق به خود تواند گفت",18,"",0],[65490,1889,"sh5","ای ظهور تو با بطون دمساز",48,"",0],[65491,1889,"sh6","جامی از گفتگو ببند زبان",44,"",0],[65492,1889,"sh7","ای دل و دیده خاک نعلینت",42,"",0],[65493,1889,"sh8","حق چو داد از پی اطیعواالله",49,"",0],[65494,1889,"sh9","ای به شاهی بلند آوازه",11,"",0],[65495,1889,"sh10","روزی از روزها کلیم خدا",19,"",0],[65496,1889,"sh11","چیست دانی به زیر چرخ اثیر",13,"",0],[65497,1889,"sh12","چیست عدل آنکه بگذری ز فضول",7,"",0],[65498,1889,"sh13","هر که را دل به عدل شد مایل",6,"",0],[65499,1889,"sh14","با پسر گفت یک شبی مأمون",4,"",0],[65500,1889,"sh15","جامی اطناب در سخن نه سزاست",14,"",0],[65501,1889,"sh16","ای کشیده به کلک وهم و خیال",47,"",0],[65502,1889,"sh17","هر که حق داد نور معرفتش",6,"",0],[65503,1889,"sh18","ذکر گنج است و گنج پنهان به",6,"",0],[65504,1889,"sh19","حرفها را به وقت نطق و بیان",9,"",0],[65505,1889,"sh20","نیست لا اله الا الله",12,"",0],[65506,1889,"sh21","معنی لااله الاالله",5,"",0],[65507,1889,"sh22","می زند شیخ ما ز شور و شغب",19,"",0],[65508,1889,"sh23","مرده لوزینه پز چو از کینه",14,"",0],[65509,1889,"sh24","رقص ناقص به سوی نقص بود",5,"",0],[65510,1889,"sh25","جغد مسکین نشسته پهلوی باز",39,"",0],[65511,1889,"sh26","وان دگر شیخ پیش خلق جهان",37,"",0],[65512,1889,"sh27","روستایی ز دست باران جست",24,"",0],[65513,1889,"sh28","آنچه کردم بیان درین گفتار",13,"",0],[65514,1889,"sh29","آن زمان از ریا و عجب رهی",30,"",0],[65515,1889,"sh30","با هر که نشستی و نشد جمع دلت",16,"",0],[65516,1889,"sh31","سر مقصود را مراقبه کن",10,"",0],[65517,1889,"sh32","خواجه نقشبند بند گشای",8,"",0],[65518,1889,"sh33","شد جوانی ز سالکان طریق",9,"",0],[65519,1889,"sh34","خواجه پاک دین پاک نفس",12,"",0],[65520,1889,"sh35","شاه دین شافعی مطلبی",23,"",0],[65521,1889,"sh36","عارفی گفت هر که یارم شد",9,"",0],[65522,1889,"sh37","هم به هر قبه ای تو را روییس