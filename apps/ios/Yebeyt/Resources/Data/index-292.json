{"id":292,"poems":[[66166,292,"sh1","ای خاک تو تاج سربلندان",51,"",1],[66167,292,"sh2","هر جا به اثر نظر گمارند",36,"",0],[66168,292,"sh3","ای صدرنشین تخت کونین",38,"",0],[66169,292,"sh4","ای اشهب شبرو تو از نور",53,"",0],[66170,292,"sh5","چون صبح ازل ز عشق دم زد",39,"",1],[66171,292,"sh6","از هر چه سخنوران بدانند",32,"",0],[66172,292,"sh7","ای ساقی جان فداک روحی",70,"",0],[66173,292,"sh8","تاریخ نویس عشقبازان",57,"",0],[66174,292,"sh9","آن را که به عشق گل سرشتند",51,"",0],[66175,292,"sh10","برگشت چو قیس غم رسیده",55,"",0],[66176,292,"sh11","شب کز سر چرخ لاجوردی",41,"",0],[66177,292,"sh12","چون عیسی صبح دم برآورد",74,"",0],[66178,292,"sh13","عشق اول او سرود و شادیست",60,"",0],[66179,292,"sh14","عنوانکش این صحیفه درد",61,"",0],[66180,292,"sh15","سر فتنه نیکوان آفاق",58,"",0],[66181,292,"sh16","بیاع متاع هوشیاری",47,"",0],[66182,292,"sh17","مسکین پدرش خبر چو زان یافت",61,"",0],[66183,292,"sh18","چون قیس دریده جیب و دامان",67,"",0],[66184,292,"sh19","کی پرده عاشقی شود ساز",68,"",0],[66185,292,"sh20","چون باز سفیده دم درین باغ",54,"",0],[66186,292,"sh21","شرط است وفا به عهد کردن",57,"",0],[66187,292,"sh22","خوش نغمه مغنی حجازی",80,"",0],[66188,292,"sh23","مجنون چو به حکم آن دل افروز",39,"",0],[66189,292,"sh24","همسایه لیلی آن جمیله",62,"",0],[66190,292,"sh25","چون مانع دل رمیده مجنون",71,"",0],[66191,292,"sh26","مشاطه این عروس طناز",90,"",0],[66192,292,"sh27","آن دور ز راه و رسم مردم",88,"",0],[66193,292,"sh28","سوداگر چین این صحیفه",174,"",0],[66194,292,"sh29","ریحان شکن حریم این باغ",75,"",0],[66195,292,"sh30","چون صبحدم از غزاله خور",72,"",0],[66196,292,"sh31","خورشید به وقت بامدادان",81,"",0],[66197,292,"sh32","روشن سخن عرب کثیر",69,"",0],[66198,292,"sh33","چون رفت کثیر آن هنرور",52,"",0],[66199,292,"sh34","دهقان شکوفه بند این شاخ",106,"",0],[66200,292,"sh35","سیاح حدود این ولایت",66,"",0],[66201,292,"sh36","لیلی چو به عزم خانه برخاست",47,"",0],[66202,292,"sh37","گوهر کش این علاقه در",118,"",0],[66203,292,"sh38","طبال سرای این عروسی",88,"",0],[66204,292,"sh39","آن عاشق از خرد رمیده",78,"",0],[66205,292,"sh40","چون زرده بیضه های گردون",98,"",0],[66206,292,"sh41","دردانه فروش درج این درج",70,"",0],[66207,292,"sh42","نی باد و ز باد گرم روتر",103,"",0],[66208,292,"sh43","مجنون چو به نامه در قلم زد",66,"",0],[66209,292,"sh44","نیرنگ زن بیاض این راز",43,"",0],[66210,292,"sh45","آن رفته ز قید عقل بیرون",49,"",0],[66211,292,"sh46","گوهر کش سلک این حکایت",107,"",0],[66212,292,"sh47","آن پوست و مغز قصه اش نغز",103,"",0],[66213,292,"sh48","شیرین سخن شکر فسانه",54,"",0],[66214,292,"sh49","رامشگر این ترانه خوش",100,"",0],[66215,292,"sh50","محمل بند عروس این راز",42,"",0],[66216,292,"sh51","طغراکش این فراقنامه",95,"",0],[66217,292,"sh52","مستیش ز باده بود نز جام",25,"",0],[66218,292,"sh53","فهرست نویس این جریده",51,"",0],[66219,292,"sh54","لیلی چو ز داغ مرگ مجنون",41,"",0],[66220,292,"sh55","چون از نفس خزان درختان",94,"",0],[66221,292,"sh56","گیتی که نشیمن زوال است",40,"",0],[66222,292,"sh57","از فضل و ادب دهد قبولت",32,"",0],[66223,292,"sh58","هر چند چو بحر تلخکامی",61,"",0]]}
