,[49448,1742,"sh12","انبیا ز آسمان پیاده شدند",112,"",0],[49449,1742,"sh13","برده بر بام آسمان رختش",80,"",0],[49450,1742,"sh14","از خدای آمده بر جانت",9,"",0],[49451,1742,"sh15","زحلش زیر پای کرده نثار",57,"",0],[49452,1742,"sh16","عندلیبان باغ آن خوشبوی",32,"",0],[49453,1742,"sh17","شب معراج چون به حضرت رفت",35,"",0],[49454,1742,"sh18","ذکر ابی‌بکر الصدیق الاطهر الشیخ الاکبر الوزیر الانور الضجیع…",43,"",0],[49455,1742,"sh19","دل احمد ز کون بود نقط",18,"",0],[49456,1742,"sh20","چون زدی کوس شرع روح امین",77,"",0],[49457,1742,"sh21","ذکر امیرالمؤمنین ابی حفض عمربن الخطاب المذکور بأفضل الخطاب…",55,"",0],[49458,1742,"sh22","عدل او بود با قضا همبر",33,"",0],[49459,1742,"sh23","ذکر الشهید القتیل المظلوم ابی عمر عثمان‌بن عفان ذی‌النورین…",76,"",0],[49460,1742,"sh24","ذکر زوج‌البتول و ابن عم الرسول ابی‌الحسن والحسین المبارز…",190,"",0],[49461,1742,"sh25","در جمل چون معاویه بگریخت",21,"",0],[49462,1742,"sh26","روز صفّین چو حرب در پیوست",30,"",0],[49463,1742,"sh27","پسرِ ملجم آن سگ بد دین",30,"",0],[49464,1742,"sh28","خالِ ما بود خصم او حالی",54,"",0],[49465,1742,"sh29","فی فضیلة امیرین العادلین والسبطین قرتی العینین سیدا شباب…",1,"",0],[49466,1742,"sh30","بوعلی آنکه در مشام ولی",29,"",0],[49467,1742,"sh31","کرد خصمان برو جهان فراخ",39,"",0],[49468,1742,"sh32","ذکر الحسین یضئی العینین سلالة الانبیاء و ولدالاصفیا…",34,"",0],[49469,1742,"sh33","دشمنان قصد جان او کردند",27,"",0],[49470,1742,"sh34","حبّذا کربلا و آن تعظیم",20,"",0],[49471,1742,"sh35","بود در شهر کوفه پیرزنی",12,"",0],[49472,1742,"sh36","آدمی چون بداشت دست از صیت",14,"",0],[49473,1742,"sh37","ذکر الامامین الهادیین ابی‌حنیفة نعمان‌بن ثابت الکوفی و…",49,"",0],[49474,1742,"sh38","ذکر الامام العالم العارف جمال‌الدّین کمال الاسلام مفتی…",40,"",0],[49475,1742,"sh39","هر دو همراه راه دین بودند",44,"",0],[49476,1742,"sh40","هیچ را در جهان ز علم و ز ظن",87,"",0],[49477,1742,"sh41","عزمت از حضرت نبی و علیست",27,"",0],[49478,1742,"sh42","گفت روزی مرید خود را پیر",26,"",0],[49479,1742,"sh43","گفت روزی مرید با پیری",9,"",0],[