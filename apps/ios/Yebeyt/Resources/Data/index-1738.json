{"id":1738,"poems":[[49277,1739,"sh1","الحمدللّه الخبیر بخفیات الضمائر، البصیر بخبیات السرائر،…",37,"",0],[49279,1740,"sh1","ای درون پرور برون آرای",49,"",0],[49280,1740,"sh2","به خودش کس شناخت نتوانست",20,"",0],[49281,1740,"sh3","احدست و شمار از او معزول",34,"",0],[49282,1740,"sh4","دهر بی‌قالب قدیمی او",38,"",0],[49283,1740,"sh5","پس چو مطلوب نبود اندر جای",24,"",0],[49284,1740,"sh6","بود شهری بزرگ در حدِ غور",22,"",0],[49285,1740,"sh7","آن یکی رجل گفته آن یک ید",11,"",0],[49286,1740,"sh8","راد مردی ز غافلی پرسید",11,"",0],[49287,1740,"sh9","جانت را دوزخ آشیانه مکن",30,"",0],[49288,1740,"sh10","هرکه را عون حق حصار شود",17,"",0],[49289,1740,"sh11","راد مردی کریم پیش پسر",7,"",0],[49290,1740,"sh12","آن نبینی که پیشتر ز وجود",34,"",0],[49291,1740,"sh13","سبب هدیهٔ ایادی او",24,"",0],[49292,1740,"sh14","چون تو از بود خویش گشتی نیست",53,"",0],[49293,1740,"sh15","کاف و نون نیست جز نبشتهٔ ما",24,"",0],[49294,1740,"sh16","ابلهی دید اشتری به چرا",13,"",0],[49295,1740,"sh17","پسری احوَل از پدر پرسید",30,"",0],[49296,1740,"sh18","آن نبینی که طفل را دایه",24,"",0],[49297,1740,"sh19","نقش بند برون گلها اوست",13,"",0],[49298,1740,"sh20","آتش و باد و آب و خاک و فلک",7,"",0],[49299,1740,"sh21","با سیه باش چونت نگزیرد",23,"",0],[49300,1740,"sh22","از من و از تو کارسازی را",20,"",0],[49301,1740,"sh23","از تو زاری نکوست زور بدست",44,"",0],[49302,1740,"sh24","کرد روزی عمر به رهگذری",14,"",0],[49303,1740,"sh25","ذکر بر دوستان و کم سخنان",8,"",0],[49304,1740,"sh26","ثوری از بایزید بسطامی",8,"",0],[49305,1740,"sh27","یاد دار این سخن از آن بیدار",21,"",0],[49306,1740,"sh28","اجل آمد کلیدخانهٔ راز",35,"",0],[49307,1740,"sh29","جهد کن تا زنیست هست شوی",15,"",0],[49308,1740,"sh30","آدمی سوی حق همی پوید",15,"",0],[49309,1740,"sh31","شاکر لطف و رحمتش دیندار",65,"",0],[49310,1740,"sh32","دانش او رهی رعایت کن",41,"",0],[49311,1740,"sh33","جانور را چو خوانش پیش نهاد",27,"",0],[49312,1740,"sh34","زالکی کرد سر برون ز نهفت",7,"",0],[49313,1740,"sh35","آن بنشنیده‌ای که بی‌نم ابر",17,"",0],[49314,1740,"sh36","نه بپرسید کاهلی ز علی",6,"",0],[49315,1740,"sh37","عاشقان سوی حضرتش سرمست",38,"",0],[49316,1740,"sh38","هرکه خواهد ولایت تجرید",26,"",0],[49317,1740,"sh39","اینهمه علم جسم مختصر است",52,"",0],[49318,1740,"sh40","به پسر شیخ گوکانی گفت",6,"",0],[49319,1740,"sh41","در مناجات پیر شبلی گفت",23,"",0],[49320,1740,"sh42","پی منه با نفاق بر درگاه",5,"",0],[49321,1740,"sh43","حاتم آنگه که کرد عزم حرم",32,"",0],[49322,1740,"sh44","ربع مسکون چو از طریق شمار",11,"",0],[49323,1740,"sh45","خلق تا در جهانِ اسبابند",45,"",0],[49324,1740,"sh46","جامهٔ کهنه رنج و اندوه است",11,"",0],[49325,1740,"sh47","مرد طبّاخ نعمت بسیار",10,"",0],[49326,1740,"sh48","خر بود خادمی ولی کاهل",7,"",0],[49327,1740,"sh49","شیر خصمی مسلّط و مغرور",12,"",0],[49328,1740,"sh50","دیدن آفتاب را در خواب",11,"",0],[49329,1740,"sh51","علّت روز و شب خور است و زمین",39,"",0],[49330,1740,"sh52","هرچه داری برای حق بگذار",25,"",0],[49331,1740,"sh53","آن زمان کز خدای نزد رسول",33,"",0],[49332,1740,"sh54","در جهان یک زیان چو سودِ تو نیست",11,"",0],[49333,1740,"sh55","چند گویی رسیدگی چه بُوَد",22,"",0],[49334,1740,"sh56","روبهی پیر روبهی را گفت",6,"",0],[49335,1740,"sh57","بود پیری به بصره در زاهد",9,"",0],[49336,1740,"sh58","زاهدی از میان قوم بتاخت",10,"",0],[49337,1740,"sh59","هست شهری بزرگ در حدِِ روم",44,"",0],[49338,1740,"sh60","هرچه آن کدخدای دکاندار",10,"",0],[49339,1740,"sh61","قال‌الله تعالی: الذین یؤمنون بالغیب و یقیمون الصلوة، و قال…",45,"",0],[49340,1740,"sh62","در اُحد میر حیدر کرّار",31,"",0],[49341,1740,"sh63","بارگی را بساز آلت و زین",24,"",0],[49342,1740,"sh64","بوشعیب الاُبی امامی بود",45,"",0],[49343,1740,"sh65","در دهان هر زبان که گویا شد",23,"",0],[49344,1740,"sh66","مستمع نغمت نیاز از دل",28,"",0],[49345,1740,"sh67","از پی راه حق کم از کودک",15,"",0],[49346,1740,"sh68","ای روان همه تنومندان",44,"",0],[49347,1740,"sh69","ای خداوند قایم و قدّوس",24,"",0],[49348,1740,"sh70","ای جهان آفرین جان آرای",17,"",0],[49349,1740,"sh71","چون ز درگاهِ تست گو می‌مال",25,"",0],[49350,1740,"sh72","داده از حک