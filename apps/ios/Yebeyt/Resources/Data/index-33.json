{"id":33,"poems":[[1321,34,"sh1","به نام خداوندِ جان و خرد",15,"",10],[1322,34,"sh2","کُنون اِی خِرَدمَند وَصفِ خِرَد",19,"",10],[1323,34,"sh3","از آغاز باید که دانی دُرُست",25,"",8],[1324,34,"sh4","چو زین بُگذَری مَردُم آمد پَدید",15,"",8],[1325,34,"sh5","زِ یاقوتِ سُرخ اَست چَرخِ کَبود",5,"",8],[1326,34,"sh6","چراغ اَست مَر تیره شَب را بَسیچ",8,"",8],[1327,34,"sh7","تو را دانش و دین رهاند درست",31,"",5],[1328,34,"sh8","سخن هر چه گویم همه گفته‌اند",18,"",7],[1329,34,"sh9","چو از دفتر این داستان‌ها بَسی",10,"",7],[1330,34,"sh10","دلِ روشنِ من چو برگشت از اوی",15,"",7],[1331,34,"sh11","بدین نامه چون دست کردم دراز",16,"",7],[1332,34,"sh12","جهان آفرین تا جهان آفرید",48,"",7],[1335,35,"sh1","سخن‌گوی دهقان چه گوید نخست",51,"",8],[1336,35,"sh2","خجسته سیامک یکی پور داشت",21,"",8],[1337,36,"sh1","جهاندار هوشنگ با رای و داد",8,"",8],[1338,36,"sh2","یکی روز شاه جهان سوی کوه",15,"",9],[1339,36,"sh3","چو بشناخت آهنگری پیشه کرد",15,"",8],[1341,37,"sh1","پسر بد مر او را یکی هوشمند",46,"",6],[1342,38,"sh1","گرانمایه جمشید فرزند او",74,"",5],[1343,38,"sh2","یکی مرد بود اندر آن روزگار",45,"",6],[1344,38,"sh3","چو ابلیس پیوسته دید آن سخن",45,"",6],[1345,38,"sh4","از آن پس برآمد ز ایران خروش",28,"",6],[1346,39,"sh1","چو ضحاک شد بر جهان شهریار",11,"",8],[1347,39,"sh2","چنان بد که هر شب دو مرد جوان",30,"",7],[1348,39,"sh3","چو از روزگارش چهل سال ماند",64,"",7],[1349,39,"sh4","برآمد برین روزگار دراز",26,"",7],[1350,39,"sh5","نشد سیر ضحاک از آن جست جوی",17,"",7],[1351,39,"sh6","چو بگذشت از آن بر فریدون دو هشت",34,"",7],[1352,39,"sh7","چنان بُد که ضحاک را روز و شب",86,"",6],[1353,39,"sh8","فریدون به خورشید بر برد سر",9,"",6],[1354,39,"sh9","چو آمد به نزدیک اروندرود",28,"",6],[1355,39,"sh10","طلسمی که ضحاک سازیده بود",43,"",6],[1356,39,"sh11","چو کشور ز ضحاک بودی تهی",53,"",6],[1357,39,"sh12","جهاندار ضحاک از آن گفت‌گوی",69,"",5],[1358,40,"sh1","فریدون چو شد بر جهان کامگار",48,"",7],[1359,40,"sh2","ز سالش چو یک پنجه اندر کشید",70,"",4],[1360,40,"sh3","فرستادهٔ شاه را پیش خواند",35,"",5],[