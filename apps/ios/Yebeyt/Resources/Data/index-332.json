{"id":332,"poems":[[22773,332,"sh1","ای مرکز دایرهٔ امکان",12,"",0],[22774,332,"sh2","زین رنج عظیم، خلاصی جو",18,"",0],[22775,332,"sh3","ای باد صبا، به پیام کسی",17,"",0],[22776,332,"sh4","ای کرده به علم مجازی خوی",34,"",0],[22777,332,"sh5","ای مانده ز مقصد اصلی دور!",33,"",0],[22778,332,"sh6","عشاق جمالک احترقوا",12,"",0],[22779,332,"sh7","ای داده خلاصهٔ عمر به باد",26,"",0]]}
