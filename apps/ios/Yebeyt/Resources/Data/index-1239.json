{"id":1239,"poems":[[39322,1239,"sh1","ابتدای سخن به نام خداست",5,"",0],[39323,1239,"sh2","حی و قیوم و قادر و قاهر",11,"",0],[39324,1239,"sh3","وتر و قدوس و واحد است و صمد",3,"",0],[39325,1239,"sh4","به یقین واجب الوجود یکیست",25,"",0],[39326,1239,"sh5","راه جستن زتو هدایت از او",6,"",0],[39327,1239,"sh6","ای صفات مقدس تو صمد",12,"",0],[39328,1239,"sh7","ما ضعیفان که در مجاهده‌ایم",6,"",0],[39329,1239,"sh8","سید کائنات شمع رسل",9,"",0],[39330,1239,"sh9","بلبل گلستان «‌ما اوحی‌»",6,"",0],[39331,1239,"sh10","تو، چه دانی چه دُرِ معنی سُفت",5,"",0],[39332,1239,"sh11","دین حق را ز ابتدا ز رسول",5,"",0],[39333,1239,"sh12","قوّت دین حق ز عمّر بود",5,"",0],[39334,1239,"sh13","دین شرف یافته و دنیا زین",5,"",0],[39335,1239,"sh14","بود حیدر در مدینهٔ علم",5,"",0],[39336,1239,"sh15","دوش چون شاهد جهان افروز",15,"",0],[39337,1239,"sh16","گفتم ای مرهم دل ریشم",10,"",0],[39338,1239,"sh17","خردم دوش اندرین معنی",16,"",0],[39339,1239,"sh18","گفتم ای سایهٔ الهی تو",16,"",0],[39340,1239,"sh19","نیستم اندرین سرای مجاز",18,"",0],[39341,1239,"sh20","چه‌کنم باکه‌گویم این سخنم",28,"",0],[39342,1239,"sh21","بود روزی مبارک و فرخ",28,"",0],[39343,1239,"sh22","خالق خلق وایزد بی چون",3,"",0],[39344,1239,"sh23","در نگر تا که آفرید ترا ؟",24,"",0],[39345,1239,"sh24","تو چه پنداشتی که ایزد فرد",17,"",0],[39346,1239,"sh25","گر کنی قهر ازو نفیس شوی",23,"",0],[39347,1239,"sh26","تو اگر نیک نیکی اربدبد",8,"",0],[39348,1239,"sh27","اندر آن دم که مبدع اشیا",4,"",0],[39349,1239,"sh28","همه افتاده‌اند در تک و تاز",14,"",0],[39350,1239,"sh29","ای شده پای بست و زندانی",7,"",0],[39351,1239,"sh30","بگذر از نقش عالم گل تو",24,"",0],[39352,1239,"sh31","بگذر از وَهم و این سخن بگذار",11,"",0],[39353,1239,"sh32","دوش ناگه نهفته از اغیار",9,"",0],[39354,1239,"sh33","در جهانی که عالم ثانی است",31,"",0],[39355,1239,"sh34","رهروانی که وصل اوجویند",4,"",0],[39356,1239,"sh35","ساکنانی که جمله چون روحند",12,"",0],[39357,1239,"sh36","چه کنی عیش با زن و فرزند؟",12,"",0],[39358,1239,"sh37","ای همه ساله پای بست غرور",8,"",0],[39359,1239,"sh38","خود تو کاهل نشینی ای غافل",10,"",0],[39360,1239,"sh39","هر که آمد در این سرای غرور",12,"",0],[39361,1239,"sh40","ای شنیده فسانه بسیاری",3,"",0],[39362,1239,"sh41","تا جهان است؛ کار او این است",11,"",0],[39363,1239,"sh42","گر حیات ابد همی‌خواهی",16,"",0],[39364,1239,"sh43","هر که در راه عشق گردد مات",16,"",0],[39365,1239,"sh44","مرکب جهد زیر ران آرد",10,"",0],[39366,1239,"sh45","ای به خود راه خویش گم کرده",10,"",0],[39367,1239,"sh46","خوبرویی تو زشتخوی مباش",10,"",0],[39368,1239,"sh47","تا توانی به گرد کبر مگرد",9,"",0],[39369,1239,"sh48","صفت آنکه داردش حق دوست",19,"",0],[39370,1239,"sh49","باش پیوسته با خضوع و بکا",13,"",0],[39371,1239,"sh50","جهد آن کن که سرفراز شوی",3,"",0],[39372,1239,"sh51","ای سنایی‌ زجسم و جان بگسل!",12,"",0],[39373,1239,"sh52","اندرین ملک پادشاه‌، دلست",14,"",0],[39374,1239,"sh53","کاف و‌نون چون به یکدگرپیوست",29,"",0],[39375,1239,"sh54","لطف او هر که را دلالت داد",6,"",0],[39376,1239,"sh55","این مثل در زمانه معروف است",10,"",0],[39377,1239,"sh56","عاشقان را غذا بلا باشد",5,"",0],[39378,1239,"sh57","تا توانی به خنده لب بگشای",11,"",0],[39379,1239,"sh58","بر تو بادا که خیره کم خندی",3,"",0],[39380,1239,"sh59","هر که را داد ایزدش توفیق",5,"",0],[39381,1239,"sh60","وقت ضر و عنا دل صابر",2,"",0],[39382,1239,"sh61","در جهان هر چه هست عاریت است",23,"",0],[39383,1239,"sh62","راستی شغل نیک بختانست",7,"",0],[39384,1239,"sh63","طلب صحبت خسان نکنی",10,"",0],[39385,1239,"sh64","دوستیت مباد با نادان",8,"",0],[39386,1239,"sh65","رنگ و بویی که در جان بینی",9,"",0],[39387,1239,"sh66","آن شنیدی که از سر سوزی",18,"",0],[39388,1239,"sh67","روزی از روزها به راهگذر",6,"",0],[39389,1239,"sh68","از پی لقمه‌ای چه ترش و چه شور",17,"",0],[39390,1239,"sh69","آنکه جان آفرید‌، روزی داد",11,"",0],[39391,1239,"sh70","در کلام مجید ایزد فرد",12,"",0],[39392,1239,"sh71","ای خطاب تو نیر اعظم",11,"",0],[39393,1239,"sh72","ای مسلم‌ترا سحر خیزی",28,"",0],[39394,1239,"sh73","در جهان هرکه بینی از که و مه",8,"",0],[39395,1239,"sh74","بود در عهد ما شهی کافر",7,"",0],[39396,1239,"sh75","باز دیدم که ظالمان بودند",8,"",0],[39397,1239,"sh76","عدل شمعی بود جهان‌افروز",27,"",0],[39398,1239,"sh77","ای دریغا که در زمانهٔ ما",39,"",0]]}
