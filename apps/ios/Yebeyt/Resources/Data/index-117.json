{"id":117,"poems":[[9263,117,"sh1","بسم‌الله الرحمن الرحیم",55,"",1],[9264,117,"sh2","ای همه هستی ز تو پیدا شده",40,"",1],[9265,117,"sh3","ای به ازل بوده و نابوده ما",22,"",1],[9266,117,"sh4","تختهٔ اول که الف نقش بست",25,"",0],[9267,117,"sh5","نیم شبی کان ملک نیمروز",68,"",0],[9268,117,"sh6","شمسهٔ نُه مسند هفت‌اختران",23,"",0],[9269,117,"sh7","ای تن تو پاک‌تر از جان پاک",33,"",0],[9270,117,"sh8","ای مدنی بُرقِع و مَکی نقاب",27,"",0],[9271,117,"sh9","ای گهر‌ِ تاج‌ِ فرستادگان",41,"",0],[9272,117,"sh10","من که درین دایرهٔ دهر‌بند",29,"",0],[9273,117,"sh11","ای شرف گوهر آدم به تو",36,"",0],[9274,117,"sh12","من‌که سراینده این نوگلم",43,"",0],[9275,117,"sh13","جنبش اول که قلم برگرفت",27,"",0],[9276,117,"sh14","چونکه نَسَخته سخن سرسری",66,"",0],[9277,117,"sh15","چون سپر انداختن آفتاب",85,"",0],[9278,117,"sh16","رایض من چون ادب آغاز کرد",75,"",0],[9279,117,"sh17","باد، نقاب از طرفی برگرفت",30,"",0],[9280,117,"sh18","خواجه یکی شب به تمنای جنس",55,"",0],[9281,117,"sh19","عمر بر آن فرش ازل بافته",46,"",0],[9282,117,"sh20","اوّل کاین عشق‌پرستی نبود",70,"",0],[9283,117,"sh21","دادگری دید برای صواب",23,"",0],[9284,117,"sh22","ای مَلِکِ جانوران رای تو",44,"",0],[9285,117,"sh23","صیدکنان مرکب‌ِ نوشیروان",48,"",0],[9286,117,"sh24","یک نفس ای خواجهٔ دامن‌کشان",47,"",0],[9287,117,"sh25","روزی از آنجا که فراغی رسید",26,"",0],[9288,117,"sh26","ای سپر افکنده ز مردانگی",22,"",0],[9289,117,"sh27","پیرزنی را ستمی درگرفت",36,"",0],[9290,117,"sh28","روز خوش عمر به شب‌خوش رسید",45,"",0],[9291,117,"sh29","در طرف شام یکی پیر بود",19,"",0],[9292,117,"sh30","لعبت بازی پس این پرده هست",38,"",0],[9293,117,"sh31","صیدگری بود عجب تیزبین",46,"",0],[9294,117,"sh32","ای به زمین بر چو فلک نازنین",41,"",0],[9295,117,"sh33","صبحدمی با دو سه اهلِ درون",21,"",0],[9296,117,"sh34","پیشتر از پیشتران وجود",57,"",0],[9297,117,"sh35","میوه فروشی که یمن جاش بود",8,"",0],[9298,117,"sh36","ای ز شب وصل گرانمایه‌تر",50,"",0],[9299,117,"sh37","مسجدی‌یی بسته آفات شد",17,"",0],[9300,117,"sh38","ای فلک آهسته‌تر این دور چند؟",55,"",0],[9301,117,"sh39","پای مسیحا که جهان می‌نَبَشت",18,"",1],[9302,117,"sh40","خیز و بساط فلکی درنورد",34,"",0],[9303,117,"sh41","موبد‌ی از کشور هندوستان",25,"",0],[9304,117,"sh42","خیز و وداعی بکن ایام را",36,"",0],[9305,117,"sh43","با دو حکیم از سر هم‌خانگی",32,"",0],[9306,117,"sh44","پیری عالم نگر و تنگی‌اش",28,"",0],[9307,117,"sh45","کعبه‌روی عزم ِ ره آغاز کرد",44,"",0],[9308,117,"sh46","ای شده خشنود به یکبارگی",44,"",0],[9309,117,"sh47","پادشهی بود رعیت‌شکن",27,"",1],[9310,117,"sh48","هر نفس این پردهٔ چابک رقیب",41,"",0],[9311,117,"sh49","قصه شنیدم که در اقصای مرو",19,"",0],[9312,117,"sh50","ای به نسیمی علم افراخته",49,"",0],[9313,117,"sh51","کودکی از جملهٔ آزادگان",13,"",0],[9314,117,"sh52","ای ز خدا غافل و از خویشتن",50,"",0],[9315,117,"sh53","رهروی از جمله پیران کار",16,"",0],[9316,117,"sh54","قلب‌زنی چند که برخاستند",30,"",0],[9317,117,"sh55","خاصگی‌یی محرم جمشید بود",49,"",0],[9318,117,"sh56","مجلس خلوت نگر آراسته",55,"",0],[9319,117,"sh57","دور خلافت چو به هارون رسید",26,"",0],[9320,117,"sh58","ما که به خود دست برافشانده‌ایم",44,"",0],[9321,117,"sh59","در چمن باغ چو گلبن شکفت",15,"",0],[9322,117,"sh60","صَبَّحَکَ الله صباح ای دبیر",24,"",0]]}
