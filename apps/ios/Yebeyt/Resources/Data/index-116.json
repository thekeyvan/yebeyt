{"id":116,"poems":[[9213,116,"sh1","خرد هر کجا گنجی آرد پدید",28,"",1],[9214,116,"sh2","خدایا تویی بنده را دستگیر",28,"",0],[9215,116,"sh3","محمد که بی‌دعوی تخت و تاج",28,"",0],[9216,116,"sh4","به هر مدتی گردش روزگار",155,"",0],[9217,116,"sh5","چو فیاض دریا درآمد به موج",37,"",0],[9218,116,"sh6","شنیدم که بالای این سبز فرش",51,"",0],[9219,116,"sh7","زهی آفتابی که از دور دست",31,"",0],[9220,116,"sh8","سر فیلسوفان یونان گروه",93,"",0],[9221,116,"sh9","بساز ای مغنی ره دلپسند",68,"",0],[9222,116,"sh10","مغنی بیا ز اول صبح بام",88,"",0],[9223,116,"sh11","مُغَنّی یکی نغمه بنواز زود",80,"",0],[9224,116,"sh12","مغنی ره باستانی بزن",145,"",0],[9225,116,"sh13","مغنی بیار آن نوای غریب",130,"",0],[9226,116,"sh14","مغنی بر آهنگ خود ساز گیر",42,"",0],[9227,116,"sh15","مغنی سماعی برانگیز گرم",91,"",0],[9228,116,"sh16","مغنی بیا چنگ را ساز کن",68,"",0],[9229,116,"sh17","مغنی بدان سازِ تیمار‌ سوز",155,"",0],[9230,116,"sh18","مغنی غنا را درآور به جوش",150,"",0],[9231,116,"sh19","مغنی بیار آن ره باستان",34,"",0],[9232,116,"sh20","ارسطوی روشن‌دل هوشمند",26,"",0],[9233,116,"sh21","چنین راند والیس دانا سخن",11,"",0],[9234,116,"sh22","بلیناس دانا به زانو نشست",12,"",0],[9235,116,"sh23","چو سقراط را داد نوبت سخن",10,"",0],[9236,116,"sh24","پس آنگه که خاک زمین داد بوس",11,"",0],[9237,116,"sh25","چو قفل‌آزمایی به هرمس رسید",13,"",0],[9238,116,"sh26","فلاطون که بر جمله بود اوستاد",13,"",0],[9239,116,"sh27","چو ختم سخن قرعه بر شاه زد",14,"",0],[9240,116,"sh28","نظامی بر این در مجنبان کلید",34,"",0],[9241,116,"sh29","مغنی سحرگاه بر بانگ رود",98,"",0],[9242,116,"sh30","چنین بود در نامهٔ رهنمای",119,"",0],[9243,116,"sh31","دگر روز کز عطسهٔ آفتاب",86,"",0],[9244,116,"sh32","سوم روز کین طاق بازیچه رنگ",87,"",0],[9245,116,"sh33","سحرگه که سربرگرفتم ز خواب",335,"",0],[9246,116,"sh34","مغنی دلم دور گشت از شکیب",148,"",0],[9247,116,"sh35","مغنی مدار از غنا دست باز",305,"",0],[9248,116,"sh36","مغنی دل تنگ را چاره نیست",176,"",0],[9249,116,"sh37","مغنی بساز از دم جان‌فزای",61,"",0],[9250,116,"sh38","مغنی توئی مرغ ساعت شناس",111,"",0],[9251,116,"sh39","مغنی دگر باره بنواز رود",176,"",0],[9252,116,"sh40","مغنی یک امشب بر آواز چنگ",23,"",0],[9253,116,"sh41","مغنی بدان ساز غمگین‌نواز",41,"",0],[9254,116,"sh42","مغنی دلم سیر گشت از نفیر",27,"",0],[9255,116,"sh43","مغنی بدان جرهٔ جان‌نواز",12,"",0],[9256,116,"sh44","مغنی برآرای لحنی درست",28,"",0],[9257,116,"sh45","مغنی درین پرده دیرسال",16,"",0],[9258,116,"sh46","ببار ای مغنی نوایی شگفت",10,"",0],[9259,116,"sh47","درآرای مغنی سرم را ز خواب",14,"",0],[9260,116,"sh48","مغنی ره رامش جان بساز",10,"",0],[9261,116,"sh49","مغنی ره رامش آور پدید",47,"",0],[9262,116,"sh50","چو گوهر برون آمد از کان کوه",70,"",0]]}
