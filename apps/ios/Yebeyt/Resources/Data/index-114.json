{"id":114,"poems":[[9049,114,"sh1","ای جهان دیده بودِ خویش از تو",58,"",1],[9050,114,"sh2","نقطه خط اولین پرگار",33,"",0],[9051,114,"sh3","چون نگنجید در جهان تاجش",78,"",0],[9052,114,"sh4","چون اشارت رسید پنهانی",75,"",0],[9053,114,"sh5","ای دل از این خیال سازی چند",161,"",0],[9054,114,"sh6","آنچه او هم نو‌ است و هم کهن است",161,"",0],[9055,114,"sh7","ای پسر هان و هان تو‌را گفتم",73,"",0],[9056,114,"sh8","گوهر‌آما‌ی‌ِ گنج‌خانهٔ راز",40,"",0],[9057,114,"sh9","رفت منذر به اتفاق پدر",71,"",0],[9058,114,"sh10","چون خَوَرْنَق به فرّ بهرامی",71,"",0],[9059,114,"sh11","چون سهیل جمال بهرامی",56,"",0],[9060,114,"sh12","روزی از روضهٔ بهشتی خویش",75,"",0],[9061,114,"sh13","شاه روزی رسیده بود ز دشت",43,"",0],[9062,114,"sh14","چون ز بهرام گور با پدرش",46,"",0],[9063,114,"sh15","بس کن ای جادو‌ی سخن پیوند",43,"",0],[9064,114,"sh16","اول نامه بوَد نام خدای",48,"",0],[9065,114,"sh17","چونکه خواننده خواند نامه تمام",126,"",0],[9066,114,"sh18","بامدادان که صبح زرین تاج",28,"",0],[9067,114,"sh19","طالع تخت و پادشاهی او",132,"",0],[9068,114,"sh20","شاه روزی شکار کرد پسند",102,"",0],[9069,114,"sh21","شاه بهرام روزی از سر تخت",101,"",0],[9070,114,"sh22","چون برآمد ز ماه تا ماهی",102,"",0],[9071,114,"sh23","روزی از طالع مبارک بخت",90,"",0],[9072,114,"sh24","شه به ناز و نشاط شد مشغول",22,"",0],[9073,114,"sh25","روزی از صبح فتح نورانی",149,"",0],[9074,114,"sh26","چونکه بهرام شد نشاط‌پرست",522,"",0],[9075,114,"sh27","چو گریبان کوه و دامن دشت",230,"",0],[9076,114,"sh28","چونکه روز دوشنبه آمد شاه",254,"",0],[9077,114,"sh29","روزی از روزهای دی‌ماهی",308,"",0],[9078,114,"sh30","چارشنبه که از شکوفه مهر",447,"",0],[9079,114,"sh31","روز پنجشنبه است روزی خوب",357,"",0],[9080,114,"sh32","روز آدینه کاین مقرنس بید",324,"",0],[9081,114,"sh33","چون به تثلیث مشتری و زحل",113,"",0],[9082,114,"sh34","شه چو تنگ آمدی ز تنگی کار",116,"",0],[9083,114,"sh35","اولین شخص گفت با بهرام",166,"",0],[9084,114,"sh36","چون زمین از گلیم گرد آلود",43,"",0],[9085,114,"sh37","لعل پیوند این علاقه دُر",151,"",0],[9086,114,"sh38","چون فروزنده شد به عکس و عیار",75,"",0]]}
