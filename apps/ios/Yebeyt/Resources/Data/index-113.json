{"id":113,"poems":[[9003,113,"sh1","ای نام تو بهترین سرآغاز",105,"",1],[9004,113,"sh2","ای شاه‌سوار ملک هستی",109,"",0],[9005,113,"sh3","در نوبت بار عام دادن",100,"",0],[9006,113,"sh4","روزی به مبارکی و شادی",96,"",0],[9007,113,"sh5","سر خیل سپاه تاجدار‌ان",84,"",0],[9008,113,"sh6","ای عالم جان و جان عالم",39,"",0],[9009,113,"sh7","چون گوهر سرخ صبحگاهی",32,"",0],[9010,113,"sh8","برجوش دلا که وقت جوش است",67,"",0],[9011,113,"sh9","ای چارده ساله قرة‌العین",36,"",1],[9012,113,"sh10","ساقی به کجا که می‌ پرستم",135,"",0],[9013,113,"sh11","گویندهٔ داستان چنین گفت",79,"",1],[9014,113,"sh12","هر روز که صبح بردمیدی",53,"",1],[9015,113,"sh13","سلطان سریر صبح‌خیزان",68,"",1],[9016,113,"sh14","چون راه دیار دوست بستند",60,"",0],[9017,113,"sh15","مجنون چو شنید پند خویشان",92,"",0],[9018,113,"sh16","چون رایت عشق آن جهان‌گیر",118,"",0],[9019,113,"sh17","چون دید پدر به حال فرزند",70,"",1],[9020,113,"sh18","کبکی به دهن گرفت موری",28,"",1],[9021,113,"sh19","سر دفتر آیت نکویی",152,"",0],[9022,113,"sh20","فهرست‌کش نشاط این باغ",29,"",0],[9023,113,"sh21","لیلی پسِ پردهٔ عماری",106,"",0],[9024,113,"sh22","نوفل ز چنین عتاب دلکش",80,"",0],[9025,113,"sh23","مجنون چو شنید بوی آزرم",21,"",0],[9026,113,"sh24","گنجینه‌گشای این خزینه",93,"",0],[9027,113,"sh25","سازندهٔ ارغنون این ساز",100,"",0],[9028,113,"sh26","شبگیر که چرخ لاجوردی",40,"",0],[9029,113,"sh27","چون نور چراغ آسمان‌گرد",65,"",0],[9030,113,"sh28","غواص جواهر معانی",98,"",0],[9031,113,"sh29","فرزانه سخن‌سرای بغداد",120,"",0],[9032,113,"sh30","دهقان فصیح پارسی زاد",127,"",0],[9033,113,"sh31","چون دید پدر که دردمند است",48,"",0],[9034,113,"sh32","روزی ز قضا به وقت شبگیر",60,"",0],[9035,113,"sh33","صاحب‌خبرِ فسانه‌پرداز",99,"",0],[9036,113,"sh34","رخشنده شبی چو روز روشن",98,"",0],[9037,113,"sh35","روزی و چه روز؟ عالم افروز",161,"",0],[9038,113,"sh36","بود اول آن خجسته پرگار",81,"",1],[9039,113,"sh37","صراف سخن به لفظ چون زر",68,"",0],[9040,113,"sh38","مادر چو ز دور در، پسر دید",45,"",0],[9041,113,"sh39","چون شاه‌سوار چرخ گردان",46,"",0],[9042,113,"sh40","لیلی نه که لعبتِ حصاری",76,"",0],[9043,113,"sh41","آیا تو کجا و ما کجاییم",65,"",1],[9044,113,"sh42","دانای سخن چنین کند یاد",99,"",0],[9045,113,"sh43","هر نکته که بر نشان کاریست",74,"",0],[9046,113,"sh44","شرط است که وقت برگ‌ریزان",122,"",0],[9047,113,"sh45","انگشت‌کشِ سخن‌سرایان",63,"",0],[9048,113,"sh46","شاها ملکا جهان پناها",46,"",0]]}
