{
  "openapi": "3.1.0",
  "info": {
    "title": "yebeyt API",
    "version": "1.0.0",
    "description": "Errors are `{ \"error\": code }`; the apps turn the codes into Persian copy."
  },
  "servers": [
    {
      "url": "https://api.yebeyt.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "adminAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT, valid 15 minutes."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, valid 60 days, single use: every refresh returns a new one."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "usernameChangedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "apple",
                "google"
              ]
            }
          }
        },
        "required": [
          "id",
          "username",
          "usernameChangedAt",
          "createdAt",
          "providers"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_token",
              "unauthorized",
              "forbidden",
              "not_found",
              "rate_limited",
              "username_taken",
              "username_reserved",
              "username_too_short",
              "username_too_long",
              "username_bad_chars",
              "username_change_too_soon",
              "apple_revoke_failed",
              "payload_too_large",
              "unsupported_media_type",
              "internal_error",
              "unavailable"
            ]
          },
          "allowedAt": {
            "type": "string",
            "format": "date-time",
            "description": "With username_change_too_soon: when the next change is allowed."
          }
        },
        "required": [
          "error"
        ]
      },
      "AppleSignInRequest": {
        "type": "object",
        "properties": {
          "identityToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "authorizationCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "nonce": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "The raw nonce; its sha256 was sent to Apple."
          },
          "fullName": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "givenName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "familyName": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "description": "Accepted and ignored: the server keeps no names."
          }
        },
        "required": [
          "identityToken"
        ]
      },
      "GoogleSignInRequest": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "idToken"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "SetUsernameRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "example": "hafez_fan"
          }
        },
        "required": [
          "username"
        ]
      },
      "Progress": {
        "type": "object",
        "properties": {
          "points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000000
          },
          "streakDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000000
          },
          "streakLastDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-06-01"
          },
          "bestByGame": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000000
            }
          }
        },
        "required": [
          "points",
          "streakDays",
          "streakLastDate",
          "bestByGame"
        ]
      },
      "UsernameCheck": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "too_short",
              "too_long",
              "bad_chars",
              "reserved",
              "taken"
            ]
          }
        },
        "required": [
          "available"
        ]
      },
      "UsernameSuggestions": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          }
        },
        "required": [
          "suggestions"
        ]
      },
      "PoetPictureList": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$",
              "example": "hafez"
            },
            "version": {
              "type": "string",
              "description": "First 12 characters of the picture's sha256; changes when the picture does."
            },
            "url": {
              "type": "string",
              "description": "Path on this server, to be resolved against its address.",
              "example": "/v1/poets/hafez/picture?v=0a1b2c3d4e5f"
            }
          },
          "required": [
            "slug",
            "version",
            "url"
          ]
        }
      },
      "PoetPictureStored": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,40}$",
            "example": "hafez"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "version"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Is the server up and the database reachable?",
        "responses": {
          "200": {
            "description": "Up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/apple": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with Apple",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleSignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The token is invalid, expired or not for this app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/google": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with Google",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The token is invalid, expired or not for this app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Swap a refresh token for a new pair",
        "description": "A refresh token works once. Using one again revokes the whole sign-in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The token is invalid, expired or not for this app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End this sign-in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed out (also when the token was unknown)."
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "The signed-in user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "me"
        ],
        "summary": "Delete the account and everything stored for it",
        "description": "Revokes the Apple token when there is one. If Apple cannot be reached the account is kept (502) so the call can be repeated.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Apple could not be reached; nothing was deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/username": {
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Set or change the username",
        "description": "Free the first time; later changes only 30 days after the last one.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetUsernameRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user with the new username.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The name breaks the rules (username_too_short, username_too_long, username_bad_chars, username_reserved).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "username_taken, or username_change_too_soon with `allowedAt`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me/progress": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Points, streak and best scores",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The stored progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Add progress made as a guest",
        "description": "Merged with what is stored, keeping the larger value of each field (and, per game, of each best score).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Progress"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usernames/check": {
      "get": {
        "tags": [
          "usernames"
        ],
        "summary": "Is this username free and allowed?",
        "description": "Case-insensitive. `reason` says why not: too_short, too_long, bad_chars, reserved, taken.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": true,
            "name": "u",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Availability.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsernameCheck"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute per user).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usernames/suggestions": {
      "get": {
        "tags": [
          "usernames"
        ],
        "summary": "Up to 5 free usernames built from a latin base",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": true,
            "name": "base",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Suggestions (empty when nothing usable is left of the base).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsernameSuggestions"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (60 a minute per user).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/poets/pictures": {
      "get": {
        "tags": [
          "poets"
        ],
        "summary": "Which poets have a picture, and its version",
        "responses": {
          "200": {
            "description": "One entry per picture.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoetPictureList"
                }
              }
            }
          }
        }
      }
    },
    "/v1/poets/{slug}/picture": {
      "get": {
        "tags": [
          "poets"
        ],
        "summary": "A poet's picture",
        "description": "Cached for a day; send If-None-Match with the ETag to get 304.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$",
              "example": "hafez"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The image.",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged."
          },
          "404": {
            "description": "No picture for this poet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/poets/{slug}/picture": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Upload or replace a poet's picture",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$",
              "example": "hafez"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "required": true,
            "name": "width",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "required": true,
            "name": "height",
            "in": "query"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoetPictureStored"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Wrong or missing admin token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
